# Local development configuration. Copy to `.env` and fill in.
# For deployment, these are set via Terraform / the deploy command.
# No credential belongs in this file: platform tokens live in Secret Manager.

# --- Gemini platform (default) ---
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- Model routing (app/models.py) ---
# FAST_MODEL_NAME=gemini-3.8-flash
# REASONING_MODEL_NAME=gemini-4-argon

# --- Context compaction (app/agent.py) ---
# COMPACTION_TOKEN_THRESHOLD=60000
# COMPACTION_RETAIN_EVENTS=8

# --- Sessions and memory (app/app_utils/services.py) ---
# Local default: SQLite file under .adk/. On Agent Runtime: managed sessions + Memory Bank.
# USE_IN_MEMORY_SESSION=true
# LOCAL_SESSION_DB=.adk/sessions.sqlite3
# SESSION_SERVICE_URI=
# MEMORY_SERVICE_URI=

# --- Article store (app/persistence.py) ---
# Unset: SQLite inside the workspace directory. Set: Firestore in that project.
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# FIRESTORE_COLLECTION=blog_projects

# --- Working files (app/settings.py) ---
# BLOG_AGENT_WORKSPACE_DIR=workspace
# BLOG_AGENT_HTTP_TIMEOUT=20
# BLOG_AGENT_MAX_ARTICLE_CHARS=60000

# --- Secrets (app/secrets.py) ---
# Lookup order: environment variable -> Secret Manager -> local file.
# Secret names: QIITA_ACCESS_TOKEN, DEVTO_API_KEY
# SECRET_MANAGER_PROJECT=your-gcp-project-id
# BLOG_AGENT_LOCAL_SECRETS_FILE=/path/outside/the/repo/secrets.json

# --- PII redaction (app/redaction.py) ---
# Regex redaction is always on. Set to true to also call Cloud DLP.
# BLOG_AGENT_ENABLE_DLP=true
# DLP_PROJECT_ID=your-gcp-project-id

# --- Web front end (app/web_ui.py) ---
# Host for `python -m app.fast_api_app` only (the container sets its own).
# Localhost unless set; 0.0.0.0 accepts other machines.
# BLOG_AGENT_API_HOST=127.0.0.1

# --- Google Slides (app/google_slides.py) ---
# Draw Mermaid diagrams as slide images. Sends the diagram source to mermaid.ink.
# BLOG_AGENT_RENDER_MERMAID=true
