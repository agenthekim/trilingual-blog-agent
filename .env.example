# Local development configuration. Copy to `.env` and fill in.
# For deployment, these are set via Terraform / the deploy command.
# No credential belongs in this file: platform tokens live in Secret Manager.
#
# The page server and the agent's API server read `.env` when they start
# (app/env_file.py). With BLOG_AGENT_NO_DOTENV set to any value in the
# environment itself (not in this file) nothing is read; the unit tests set
# it, so a developer's settings never reach them.

# --- Gemini platform (default) ---
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- Model routing (app/models.py) ---
# The lines below show the defaults written in the code. The judge of
# `agents-cli eval run` uses FAST_MODEL_NAME too.
# FAST_MODEL_NAME=gemini-3.8-flash
# REASONING_MODEL_NAME=gemini-4-argon

# --- Context compaction (app/agent.py) ---
# COMPACTION_TOKEN_THRESHOLD=60000
# COMPACTION_RETAIN_EVENTS=8

# --- Sessions and memory (app/app_utils/services.py) ---
# Local default: SQLite file under .adk/. On Agent Runtime: managed sessions + Memory Bank.
# SESSION_SERVICE_URI, when set, is used before anything else.
# USE_IN_MEMORY_SESSION=true
# LOCAL_SESSION_DB=.adk/sessions.sqlite3
# SESSION_SERVICE_URI=
# MEMORY_SERVICE_URI=

# --- Article store (app/persistence.py) ---
# Unset: SQLite inside the workspace directory. Set: Firestore in that project.
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# FIRESTORE_COLLECTION=blog_projects

# --- Working files (app/settings.py) ---
# BLOG_AGENT_WORKSPACE_DIR=workspace
# BLOG_AGENT_HTTP_TIMEOUT=20
# BLOG_AGENT_MAX_ARTICLE_CHARS=60000

# --- Secrets (app/secrets.py) ---
# Lookup order: environment variable -> Secret Manager -> local file.
# Secret names: QIITA_ACCESS_TOKEN, DEVTO_API_KEY, GOOGLE_SLIDES_OAUTH
# (the last one is written by scripts/authorize_google_slides.py).
# Secret Manager is read in SECRET_MANAGER_PROJECT, else GOOGLE_CLOUD_PROJECT.
# The local file is read line by line as NAME=value (dotenv style, not
# JSON); quotes around a value are dropped. Only its path is set here, and
# the file stays outside the repository.
# SECRET_MANAGER_PROJECT=your-gcp-project-id
# BLOG_AGENT_LOCAL_SECRETS_FILE=/path/outside/the/repo/secrets.env

# --- PII redaction (app/redaction.py) ---
# Regex redaction is always on. Set to true to also call Cloud DLP.
# BLOG_AGENT_ENABLE_DLP=true
# DLP_PROJECT_ID=your-gcp-project-id

# --- Tracing (app/observability.py) ---
# The page and the script give every action a trace. Set to cloud to export
# the spans to Cloud Trace (needs GOOGLE_CLOUD_PROJECT and the Cloud Trace API).
# Without it nothing is exported; log records still carry the trace ids.
# BLOG_AGENT_TRACE_EXPORT=cloud

# --- Web front end (app/web_ui.py) ---
# Only when the page server is started with --host for another address than
# localhost: every route then needs this access token (16 or more letters,
# digits, - or _, with at least one digit). Unset, a new one is made at each
# start. Either way the address to open is shown once in the terminal.
# BLOG_AGENT_UI_TOKEN=
# Host for `python -m app.fast_api_app` only (the container sets its own).
# Localhost unless set; 0.0.0.0 accepts other machines.
# BLOG_AGENT_API_HOST=127.0.0.1

# --- Google Slides (app/settings.py, app/google_slides.py) ---
# Draw Mermaid diagrams as slide images and in previews. Sends the diagram
# source to mermaid.ink.
# BLOG_AGENT_RENDER_MERMAID=true
# How many languages have their slides planned at the same time (3 unless
# set). Set 1 when the model quota does not carry several planning runs.
# BLOG_AGENT_SLIDE_PARALLELISM=3

# --- Agent API server (app/fast_api_app.py) ---
# Origins allowed by CORS, separated by commas. Unset: none.
# ALLOW_ORIGINS=

# --- Set by the deployment, not here ---
# Read by the code and listed so that every variable it reads is named in
# this file: GOOGLE_CLOUD_AGENT_ENGINE_ID, GOOGLE_CLOUD_AGENT_ENGINE_LOCATION,
# GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY, LOGS_BUCKET_NAME (artifacts in
# Cloud Storage), APP_URL and AGENT_VERSION (the A2A agent card).
